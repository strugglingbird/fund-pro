# Use a domain already pointed to this server's public IP. Caddy will issue HTTPS automatically.
API_DOMAIN=api.example.com
WEB_DOMAIN=example.com
SERVER_IP=203.0.113.10
MYSQL_DATABASE=quant_workbench
MYSQL_USER=quant
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
FUND123_ESTIMATE_URL=
# Optional image mirror overrides for networks that cannot reach Docker Hub.
MYSQL_IMAGE=mysql:8.4
PYTHON_IMAGE=python:3.11-slim
CADDY_IMAGE=caddy:2.8-alpine
